[Container]
ContainerName=raptorpath-brief
Image=docker.io/library/python:3.12-slim
Pod=raptorpath.pod
Volume=/home/raptorpath/current:/srv:ro,Z
Secret=raptorpath-email,type=env,target=CF_EMAIL_TOKEN
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
WorkingDir=/srv
Exec=python3 -u /srv/app/brief.py

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
