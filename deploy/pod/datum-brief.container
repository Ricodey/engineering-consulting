[Unit]
ConditionPathExists=/home/datum/current/app/brief.py

[Container]
ContainerName=datum-brief
Image=docker.io/library/python:3.12-slim
Pod=datum.pod
Volume=/home/datum/current:/srv:ro,Z
EnvironmentFile=/home/datum/form.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
WorkingDir=/srv
Exec=python3 -u /srv/app/brief.py

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
