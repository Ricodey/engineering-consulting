[Unit]
Description=Datum project brief
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=datum
Group=datum
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/datum/form.env
WorkingDirectory=/var/www/datum/current
ExecStart=/usr/bin/python3 /var/www/datum/current/app/brief.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
