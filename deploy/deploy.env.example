# Copy to deploy/deploy.env. That file is shell assignments and is not committed.
# DEPLOY_HOST is the server hostname or IPv4 address. SSH is on port 4041.
# DEPLOY_SSH_KEY is the path to the private key for DEPLOY_USER.
# The release directory on the server is /var/www/datum.
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_SSH_PORT=4041
DEPLOY_SSH_KEY=
