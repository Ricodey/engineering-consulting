# SMTP submission. The brief service always uses STARTTLS on port 587.
# If a value contains spaces or #, wrap it in double quotes.
# MAIL_TO is the inbox that receives briefs. The page shows hello@datum.studio.
# SMTP_FROM is the address your provider lets this server send as.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_TO=hello@datum.studio
