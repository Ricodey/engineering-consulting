# Copy to deploy/deploy.env. That file is shell assignments and is not committed.
# DEPLOY_HOST is the server hostname or IPv4 address.
# DEPLOY_SSH_PORT is the port sshd already uses. This install does not change it.
# DEPLOY_SSH_KEY is the path to the private key for the datum user.
# DEPLOY_SSH_KNOWN_HOSTS is a known_hosts file for that host and port.
# The release directory on the server is /home/datum.
# The release workflow writes the CLOUDFLARE_* values from repository secrets.
# CLOUDFLARE_API_TOKEN needs Account Cloudflare Tunnel Edit, and Zone DNS Edit
# for pancakeboard.com. Do not commit the filled file.
DEPLOY_HOST=
DEPLOY_USER=datum
DEPLOY_SSH_PORT=4041
DEPLOY_SSH_KEY=
DEPLOY_SSH_KNOWN_HOSTS=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
