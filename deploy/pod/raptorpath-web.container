[Container]
ContainerName=raptorpath-web
Image=docker.io/library/nginx:1.28-alpine
Pod=raptorpath.pod
Volume=/home/raptorpath/current/public:/usr/share/nginx/html:ro,Z
Volume=/home/raptorpath/nginx.conf:/etc/nginx/conf.d/default.conf:ro,Z

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
